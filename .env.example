# Backend-only configuration. Keep the real .env out of version control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
DEV_MODE_MOCK_AI=true
DEVELOPMENT=true
MAX_UPLOAD_MB=5
MAX_EXTRACTED_MB=20
MAX_FILE_KB=256
MAX_FILES=100
TEST_TIMEOUT_SECONDS=45
PROJECT_TTL_SECONDS=7200
SANDBOX_IMAGE=devpilot-runner:local
